/*
 * Platform-specific LVGL configuration
 * This file is automatically generated by CMake
 */

#pragma once

/* Linux Platform - Enable available backends detected by CMake */

/* Color depth from board configuration */
#define LV_COLOR_DEPTH          @BOARD_DISPLAY_COLOR_DEPTH@

#define LV_USE_OS               LV_OS_NONE

/* Display backends */
#define LV_USE_LINUX_FBDEV      @LV_USE_FBDEV@
#define LV_USE_LINUX_DRM        @LV_USE_DRM@
#define LV_USE_SDL              @LV_USE_SDL@
#define LV_USE_X11              @LV_USE_X11@
#define LV_USE_OPENGLES         @LV_USE_OPENGLES@

/* Input backends */
#define LV_USE_EVDEV            @LV_USE_EVDEV@
#define LV_USE_LIBINPUT         @LV_USE_LIBINPUT@

/* Backend-specific configuration */
#if LV_USE_SDL
#define LV_SDL_INCLUDE_PATH     <SDL2/SDL.h>
#define LV_SDL_BUF_COUNT        2
#define LV_SDL_ZOOM             1
#define LV_SDL_ANTIALIASING     0
#define LV_SDL_MOUSE_CURSOR     1
#define LV_SDL_MOUSEWHEEL_MODE  LV_SDL_MOUSEWHEEL_MODE_ENCODER
#define LV_SDL_RENDER_MODE      LV_DISPLAY_RENDER_MODE_DIRECT
#endif

#if LV_USE_X11
#define LV_X11_DIRECT_EXIT      1
#define LV_X11_DOUBLE_BUFFER    1
#define LV_X11_RENDER_MODE      LV_DISPLAY_RENDER_MODE_PARTIAL
#endif

#if LV_USE_LINUX_FBDEV
#define LV_LINUX_FBDEV_DEVICE   "/dev/fb0"
#define LV_LINUX_FBDEV_RENDER_MODE LV_DISPLAY_RENDER_MODE_PARTIAL
#endif

#if LV_USE_LINUX_DRM
#define LV_USE_LINUX_DRM_GBM_BUFFERS 0
#define LV_LINUX_DRM_USE_EGL         0
#endif

#if LV_USE_EVDEV
#define LV_EVDEV_POINTER_DEVICE   "/dev/input/event0"
#define LV_EVDEV_MOUSE_DEVICE     "/dev/input/event1"
#define LV_EVDEV_MOUSEWHEEL_DEVICE "/dev/input/event2"
#define LV_EVDEV_KEYBOARD_DEVICE   "/dev/input/event3"
#endif
