{
	"name": "ESP-IDF QEMU",
	"build": {
		"dockerfile": "Dockerfile",
		"options": []
	},

	"mounts": [
		"source=extensionCache,target=/root/.vscode-server/extensions,type=volume",
		"source=claude-config-espidf,target=/home/esp/.claude,type=volume"
	],

	"containerEnv": {
        	"ANTHROPIC_BASE_URL": "http://127.0.0.1:8787",

			"ESPPORT": "rfc2217://host.docker.internal:4000?ign_set_control"
            // "ESPBAUD": "460800"   // optionnel : flash plus rapide
        },

	"postCreateCommand": "sudo chown -R esp:esp /home/esp/.claude && headroom mcp install --proxy-url http://127.0.0.1:8787 --force",
	"postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/start-headroom.sh",

	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"idf.espIdfPath": "/opt/esp/idf",
				"idf.customExtraPaths": "",
				"idf.pythonBinPath": "/opt/esp/python_env/idf5.5_py3.12_env/bin/python",
				"idf.toolsPath": "/opt/esp",
				"idf.gitPath": "/usr/bin/git"
			},
			"extensions": [
				"ms-vscode.cpptools-extension-pack",
				"ms-vscode.makefile-tools",
				"lizebang.bash-extension-pack",
				"ms-vscode.cmake-tools",
				"espressif.esp-idf-extension",
				"Vue.volar",
				"golang.go",
				"Anthropic.claude-code"
			]
		},
		"codespaces": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"idf.espIdfPath": "/opt/esp/idf",
				"idf.customExtraPaths": "",
				"idf.pythonBinPath": "/opt/esp/python_env/idf5.5_py3.12_env/bin/python",
				"idf.toolsPath": "/opt/esp",
				"idf.gitPath": "/usr/bin/git"
			},
			"extensions": [
				"ms-vscode.cpptools-extension-pack",
				"ms-vscode.makefile-tools",
				"lizebang.bash-extension-pack",
				"ms-vscode.cmake-tools",
				"espressif.esp-idf-extension"
			]
		}
	},
	"runArgs": [
		"--privileged",
		"--network=host",
		"-e DISPLAY=192.168.64.3:0",
		"-v", "/tmp/.X11-unix:/tmp/.X11-unix"
	]
}

