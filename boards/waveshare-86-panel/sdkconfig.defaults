# Board-specific sdkconfig for Waveshare 86-Panel
# This file is loaded after sdkconfig.defaults and sdkconfig.defaults.esp32p4

# Use custom partition table with dual OTA
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/waveshare-86-panel/partitions.csv"

# Enable OTA support
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"