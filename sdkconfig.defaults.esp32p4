CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

CONFIG_LWIP_TCP_SACK_OUT=y

# Allow writing OTA above 16Mb
CONFIG_BOOTLOADER_CACHE_32BIT_ADDR_QUAD_FLASH=y
CONFIG_PARTITION_TABLE_OFFSET=0xC000

# waveshare-86-panel have rev < 3 chips for now.
# Enhance this to build a compatible rev 3 binary with a separated build
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y
CONFIG_ESP32P4_REV_MIN_FULL=0
CONFIG_ESP_REV_MIN_FULL=0

# ESP-Hosted: SDIO transport to ESP32-C6 coprocessor
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_SLOT=1
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=14
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=54

# Hardware-accelerated screen rotation via Pixel Processing Accelerator (P4-only).
# Used by esp_lvgl_port when sw_rotate=true; off-loads the rotation from CPU,
# critical for landscape boards (touchlcd-7/8/10) where the panel is portrait-native.
CONFIG_LVGL_PORT_ENABLE_PPA=y

# LVGL PPA draw unit: accelerates fill / blit / image draws via PPA.
# Requires the local patch in components/lvgl/src/draw/espressif/ppa/ that
# adds an explicit esp_cache_msync(C2M) before each PPA op — LVGL 9.5's
# single invalidate_cache_cb doesn't run between interleaved SW and PPA
# draw tasks, which otherwise leaves SW-drawn glyphs stale in cache and
# produces vertical streaks in dynamic text labels.
CONFIG_LV_USE_PPA=y
CONFIG_LV_USE_PPA_IMG=y

# LVGL 9.5+ with PPA requires buffers aligned to ESP32-P4 L2 cache line (128 bytes).
CONFIG_LV_DRAW_BUF_ALIGN=128
CONFIG_LV_DRAW_BUF_STRIDE_ALIGN=1
CONFIG_LV_ATTRIBUTE_MEM_ALIGN_SIZE=128